# ==================== BASE DE DATOS ====================
DATABASE_URL="postgresql://usuario:contraseña@host:5432/nombre_db"

# ==================== WHATSAPP CLOUD API ====================
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_TOKEN=tu_token_de_acceso_permanente
WHATSAPP_PHONE_ID=tu_phone_number_id
WHATSAPP_VERIFY_TOKEN=un_token_secreto_que_tu_eliges

# ==================== MAPBOX (geocoding + distancia) ====================
MAPBOX_ACCESS_TOKEN=tu_access_token_de_mapbox

# ==================== CLOUDINARY (evidencia fotográfica) ====================
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ==================== DATOS DE SERVELOZ ====================
SERVELOZ_NOMBRE=Serveloz
TARIFA_MINIMA=3300

# ==================== NOTIFICACIONES ====================
# Teléfono del dueño (formato internacional: 573001234567)
ADMINISTRADOR_TELEFONO=

# ==================== PAGOS ====================
# Opcional: número de Nequi/Llave a mostrar en el chat del cliente al confirmar
# el pedido. Si se deja vacío, solo se listan los métodos aceptados sin número.
PAGO_NEQUI_LLAVE_NUMERO=

# ==================== PANEL DE ADMINISTRACIÓN ====================
# El servidor no arranca sin estas 3 variables (WHATSAPP_VERIFY_TOKEN
# tampoco tiene valor por defecto) — no dejes estos placeholders tal cual.
ADMIN_USERNAME=cambia_este_usuario
ADMIN_PASSWORD=cambia_esta_contraseña
JWT_SECRET=una_clave_secreta_muy_larga_y_segura
ADMIN_PANEL_ENABLED=true

# ==================== SERVIDOR ====================
PORT=3000
NODE_ENV=production
TZ=America/Bogota

# ==================== BOT ====================
TIMEOUT_CONVERSACION=300000
# Minutos antes de la hora programada para avisar al dueño de una carrera agendada
# que todavía no tiene conductor asignado
AVISO_PROGRAMADA_MINUTOS_ANTES=30
# Minutos antes de la hora programada para recordarle al conductor ya asignado
# que tiene un servicio pendiente. También es el margen mínimo: si al asignar
# ya faltan menos de estos minutos, no se envía el recordatorio (la
# notificación de asignación ya es suficiente aviso)
AVISO_EJECUCION_MINUTOS_ANTES=30
# Minutos de inactividad antes de reanudar el bot automáticamente en una
# conversación en modoManual (asesor humano tomó control). Cubre tanto al
# asesor que nunca respondió como al admin que olvidó pulsar "Reanudar bot"
# en el panel.
TIMEOUT_MODO_MANUAL_MINUTOS=30
# Minutos antes de cada timeout en los que se manda un único mensaje de
# "¿sigues ahí?" al cliente en vez de dejar que la conversación expire en
# silencio (el segundo aplica solo dentro de modoManual).
AVISO_INACTIVIDAD_ANTES_MINUTOS=2
AVISO_INACTIVIDAD_MODO_MANUAL_ANTES_MINUTOS=5
